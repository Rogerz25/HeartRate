    H, W = frame.shape[:2]
    fs = max(0.7, H / 800)
    (tw, _), _ = cv2.getTextSize(message, cv2.FONT_HERSHEY_SIMPLEX, fs, 2)
    org = (max(10, (W - tw) // 2), H - int(30 * fs))
    cv2.putText(frame, message, org, cv2.FONT_HERSHEY_SIMPLEX, fs, (0, 0, 0), 5, cv2.LINE_AA)
    cv2.putText(frame, message, org, cv2.FONT_HERSHEY_SIMPLEX, fs, (80, 220, 255), 2, cv2.LINE_AA)


class Station:
    """Camera + face mesh + on-screen display, shared by every trial and screen."""

    def __init__(self, camera, width=None, height=None):
        self.is_file = not str(camera).isdigit()
        self.cap = cv2.VideoCapture(camera if self.is_file else int(camera))
        if not self.cap.isOpened():
            raise SystemExit("Could not open the camera / video source.")
        if width and height and not self.is_file:
            self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, width)
            self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
        fps = self.cap.get(cv2.CAP_PROP_FPS) if self.is_file else 0.0
        self.file_fps = fps if fps and fps > 1 else 30.0
        self.frame_idx = 0

        self.mp_face_mesh = mp.solutions.face_mesh
        self.mp_drawing = mp.solutions.drawing_utils
        self.mp_styles = mp.solutions.drawing_styles
        self.mesh = self.mp_face_mesh.FaceMesh(
            max_num_faces=1,
            refine_landmarks=True,
            min_detection_confidence=0.5,
            min_tracking_confidence=0.6,
        )
        self.logo = load_logo()
        self.show_mesh = True
        self.notice, self.notice_until = "", 0.0
        cv2.namedWindow(WIN, cv2.WINDOW_NORMAL)
        print("MORPHEUS: Eye & Mouth Fatigue Tracker")
        print("P = start POST-EVA | M = toggle face mesh | ESC / q = quit")

    def event_time(self) -> float:
        """When the frame just read was captured (monotonic seconds). For a video
        file it is the position in the video, so replays are windowed correctly."""
        if self.is_file:
            return self.frame_idx / self.file_fps
        return time.perf_counter()

    def notify(self, message, seconds=2.5):
        self.notice, self.notice_until = message, time.perf_counter() + seconds

    def grab(self):
        """Read a frame and measure it. Returns (frame, Frame, face_landmarks) or None."""
        ok, frame = self.cap.read()
        if not ok:
            return None
        t = self.event_time()
        self.frame_idx += 1
        frame = cv2.flip(frame, 1)
        res = self.mesh.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        if not res.multi_face_landmarks:
            return frame, Frame(t, False), None
        face = res.multi_face_landmarks[0]
        lm = face.landmark
        ear = (calculate_ear(lm, left_eye_indices) + calculate_ear(lm, right_eye_indices)) / 2.0
        return frame, Frame(t, True, float(ear), float(calculate_mar(lm))), face

    def render(self, frame, f: Frame, face, trial: Optional[Trial], label, color,
               remaining, progress, state, lines=()):
        """Draw overlays + stats, show the frame, handle display keys. Returns the key."""
        h, w = frame.shape[:2]
        if face is not None:
            lm = face.landmark
            if self.show_mesh:
                self.mp_drawing.draw_landmarks(
                    frame, face, self.mp_face_mesh.FACEMESH_TESSELATION,
                    landmark_drawing_spec=None,
                    connection_drawing_spec=self.mp_styles.get_default_face_mesh_tesselation_style())
            draw_points(frame, lm, LEFT_EYE_CONTOUR, w, h, (0, 255, 0))
            draw_points(frame, lm, RIGHT_EYE_CONTOUR, w, h, (0, 255, 0))
            draw_points(frame, lm, left_pupil_indices, w, h, (0, 0, 255), 2)
            draw_points(frame, lm, right_pupil_indices, w, h, (0, 0, 255), 2)
            draw_points(frame, lm, [UPPER_LIP, LOWER_LIP, LEFT_MOUTH_CORNER, RIGHT_MOUTH_CORNER],
                        w, h, (255, 0, 0), 3)

        if self.logo is not None:
            overlay_logo(frame, self.logo)

        blinks = len(trial.blinks) if trial else 0
        yawns = len(trial.yawns) if trial else 0
        closed_s = trial.closed_s if trial else 0.0
        open_s = max(0.0, trial.valid_s - trial.closed_s) if trial else 0.0
        cv2.putText(frame, f"Blinks: {blinks}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        cv2.putText(frame, f"Eyes Open: {int(open_s // 60)}m {int(open_s % 60)}s", (10, 60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
        cv2.putText(frame, f"Eyes Closed: {int(closed_s // 60)}m {int(closed_s % 60)}s", (10, 90),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
        cv2.putText(frame, f"Yawns: {yawns}", (10, 120),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)
        if f.face:
            cv2.putText(frame, f"E.A.R.: {f.ear:.3f}", (10, 150),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
            closed = f.ear < EAR_THRESHOLD
            cv2.putText(frame, "EYES CLOSED" if closed else "EYES OPEN", (w - 150, 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255) if closed else (0, 255, 0), 2)

        draw_trial_card(frame, label, color, remaining, progress, state, lines)
        if time.perf_counter() < self.notice_until:
            draw_notice(frame, self.notice)
        cv2.imshow(WIN, frame)

        key = cv2.waitKey(1) & 0xFF
        if key == ord("m"):
            self.show_mesh = not self.show_mesh
        return key

    def close(self):
        self.mesh.close()
        self.cap.release()
        cv2.destroyAllWindows()


# =============================================================== trial screens ===
def run_trial(station: Station, label: str) -> Optional[Trial]:
    """Run one 30 s window. Returns the Trial, or None if the operator quit or the
    camera / video ended before it finished."""
    trial = Trial(label)
    color = COLORS[label]
    while True:
        got = station.grab()
        if got is None:
            print(f"{label}: the camera / video ended before the window was complete.")
            return None
        frame, f, face = got
        trial.feed(f)

        if trial.t0 is None:
            state, remaining, progress = "WAITING FOR FACE...", None, 0.0
        elif f.t < trial.t1:
            state, remaining = "RECORDING", trial.remaining(f.t)
            progress = (f.t - trial.t0) / trial.length
        else:
            state, remaining, progress = "FINISHING LAST BLINK/YAWN...", 0.0, 1.0

        key = station.render(frame, f, face, trial, label, color, remaining, progress, state)
        if key in QUIT_KEYS:
            return None
        if key in P_KEYS:
            station.notify("PRE-EVA must finish before POST-EVA can start"
                           if label == PRE else "POST-EVA is already in progress")
        if trial.done:
            return trial


def summary_line(trial: Trial) -> str:
    m = trial.metrics()
    rate = f"{m['blink_rate_per_min']:.1f}/min" if "blink_rate_per_min" in m else "n/a"
    return f"{trial.label}: {len(trial.blinks)} blinks ({rate}), {len(trial.yawns)} yawns"


def wait_for_post(station: Station, pre: Trial) -> bool:
    """Live view between trials. Returns True when the operator presses P, False on quit."""
    lines = [summary_line(pre)]
    while True:
        got = station.grab()
        if got is None:
            return False
        frame, f, face = got
        key = station.render(frame, f, face, None, POST, COLORS[POST], None, 0.0,
                             "READY - press P to start", lines)
        if key in QUIT_KEYS:
            return False
        if key in P_KEYS:
            return True


def print_summary(trial: Trial):
    q = trial.quality()
    m = trial.metrics()
    print(f"{summary_line(trial)}  (valid {trial.valid_s:.1f}s of {trial.length:.0f}s, "
          f"{q['valid_coverage_pct']}% coverage)")
    if "eyes_closed_pct" in m:
        extra = f", median blink {m['median_duration_ms']} ms" if "median_duration_ms" in m else ""
        print(f"  eyes closed {m['eyes_closed_pct']}%{extra}")
    if q["issues"]:
        print("  issues: " + ", ".join(q["issues"]))


# ------------------------------------------------------------------- main ---
def main(argv=None):
    ap = argparse.ArgumentParser(description="PRE-EVA vs POST-EVA blink / yawn trials")
    ap.add_argument("--camera", default="0", help="camera index or video file path")
    ap.add_argument("--width", type=int, default=None)
    ap.add_argument("--height", type=int, default=None)
    ap.add_argument("--outdir", default="eva_data")
    # ONEIROS contract output (enabled by --person)
    ap.add_argument("--person", help="pseudonymous crew ID, e.g. PSEUDO-001 (enables cv.raw messages)")
    ap.add_argument("--session", help="session ID shared by blink/arm/rppg (default: generated)")
    ap.add_argument("--src", default="cv-blink-01", help="client ID / src (lowercase, digits, hyphens)")
    ap.add_argument("--origin", choices=["auto", "live", "replay", "synthetic"], default="auto",
                    help="auto = live for a camera index, replay for a video file")
    ap.add_argument("--schema", default=str(Path(__file__).with_name("oneiros-contract.schema.json")))
    ap.add_argument("--mqtt-host", help="broker host; publishes cv.raw there")
    ap.add_argument("--mqtt-port", type=int, default=1883)
    ap.add_argument("--mqtt-transport", choices=["tcp", "websockets"], default="tcp")
    args = ap.parse_args(argv)
    outdir = Path(args.outdir)

    contract = validator = None
    if args.mqtt_host and not args.person:
        ap.error("--mqtt-host needs --person")
    if args.person:
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", args.src):
            ap.error("--src must be lowercase letters, digits and hyphens")
        origin = args.origin if args.origin != "auto" else (
            "live" if str(args.camera).isdigit() else "replay")
        session = args.session or datetime.now().strftime("s-%Y-%m-%d-%H%M%S")
        contract = make_contract_config(args.src, args.person, session, origin)
        validator = load_validator(Path(args.schema))
        print(f"ONEIROS: src={contract.src} person={contract.person} "
              f"session={contract.session} origin={contract.origin}")

    station = Station(args.camera, args.width, args.height)
    mqtt_client = None
    try:
        if contract is not None and args.mqtt_host:
            try:
                mqtt_client = OneirosMqtt(args.mqtt_host, args.mqtt_port, contract.src,
                                          args.mqtt_transport)
                print(f"Connected to broker {args.mqtt_host}:{args.mqtt_port}")
            except Exception as e:   # keep measuring; data is still saved locally
                print(f"WARNING: could not connect to the broker ({e}); saving files only")

        pre = run_trial(station, PRE)                       # starts automatically
        if pre is None:
            return
        print(f"Saved {save_trial(pre, outdir)}")
        print_summary(pre)
        emit_contract_message(pre, contract, validator, outdir, mqtt_client)

        if not wait_for_post(station, pre):                 # waits for the P key
            return
        post = run_trial(station, POST)
        if post is None:
            return
        if windows_overlap(pre, post):
            print("WARNING: PRE-EVA and POST-EVA windows overlap - this should not happen")
        print(f"Saved {save_trial(post, outdir)}")
        print_summary(post)
        emit_contract_message(post, contract, validator, outdir, mqtt_client)
    finally:
        if mqtt_client is not None:
            mqtt_client.close()
        station.close()


if __name__ == "__main__":
    main()
