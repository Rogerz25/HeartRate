def draw_points(frame, landmarks, indices, w, h, color, radius=2):
    for i in indices:
        x = int(landmarks[i].x * w)
        y = int(landmarks[i].y * h)
        cv2.circle(frame, (x, y), radius, color, -1)


def overlay_logo(frame, logo):
    h, w = frame.shape[:2]
    lh, lw = logo.shape[:2]
    x_offset = w - lw - 0
    y_offset = h - lh - 0
    if x_offset < 0 or y_offset < 0:      # frame smaller than the logo
        return

    if logo.shape[2] == 4:  # RGBA logo
        alpha = logo[:, :, 3] / 255.0
        for c in range(3):
            frame[y_offset:y_offset+lh, x_offset:x_offset+lw, c] = (
                alpha * logo[:, :, c] +
                (1 - alpha) * frame[y_offset:y_offset+lh, x_offset:x_offset+lw, c]
            )
    else:
        frame[y_offset:y_offset+lh, x_offset:x_offset+lw] = logo


def load_logo():
    logo = cv2.imread(LOGO_PATH, cv2.IMREAD_UNCHANGED)  # RGBA
    if logo is None:
        print("Warning: Logo not found. Continuing without logo.")
        return None
    scale = LOGO_HEIGHT / logo.shape[0]
    return cv2.resize(logo, (int(logo.shape[1] * scale), LOGO_HEIGHT))


def calculate_ear(landmarks, eye_indices):
    """Calculate Eye Aspect Ratio (EAR) for blink detection"""
    eye_points = []
    for idx in eye_indices:
        eye_points.append([
            landmarks[idx].x,
            landmarks[idx].y
        ])

    eye_points = np.array(eye_points, dtype=np.float32)

    # Calculate vertical distances
    vertical_dist_1 = np.linalg.norm(eye_points[1] - eye_points[5])
    vertical_dist_2 = np.linalg.norm(eye_points[2] - eye_points[4])

    # Calculate horizontal distance
    horizontal_dist = np.linalg.norm(eye_points[0] - eye_points[3])

    if horizontal_dist == 0:
        return 0

    ear = (vertical_dist_1 + vertical_dist_2) / (2.0 * horizontal_dist)
    return ear


def calculate_mar(landmarks):
    """Calculate Mouth Aspect Ratio (MAR) for yawn detection"""
    mouth_points = []
    for idx in mouth_indices:
        mouth_points.append([
            landmarks[idx].x,
            landmarks[idx].y
        ])

    mouth_points = np.array(mouth_points, dtype=np.float32)

    # Calculate vertical distance
    upper_lip = np.mean(mouth_points[0:10], axis=0)
    lower_lip = np.mean(mouth_points[10:20], axis=0)
    vertical_dist = np.linalg.norm(upper_lip - lower_lip)

    # Calculate horizontal distance
    left_corner = mouth_points[0]
    right_corner = mouth_points[6]
    horizontal_dist = np.linalg.norm(left_corner - right_corner)

    if horizontal_dist == 0:
        return 0

    mar = vertical_dist / horizontal_dist
    return mar


# ================================================================ data types ===
@dataclass
class Frame:
    t: float            # EVENT time: when the frame was captured (monotonic seconds)
    face: bool          # a face was found in this frame
    ear: float = 0.0    # average eye aspect ratio
    mar: float = 0.0    # mouth aspect ratio


@dataclass
class Event:
    onset_s: float      # seconds after the window opened
    duration_ms: float


class EpisodeTracker:
    """Runs of consecutive frames where a condition holds (blink: eyes closed,
    yawn: mouth open). A run counts once it reaches `min_frames`, when it ends."""

    def __init__(self, min_frames: int):
        self.min_frames = min_frames
        self.reset()

    def reset(self):
        self.frames = 0
        self.onset: Optional[float] = None

    @property
    def ongoing(self) -> bool:
        return self.frames > 0

    def update(self, active: bool, t: float):
        """Feed one frame. Returns (onset_time, duration_s) when a qualifying
        episode has just ended, otherwise None."""
        if active:
            if self.frames == 0:
                self.onset = t
            self.frames += 1
            return None
        done = (self.onset, t - self.onset) if self.frames >= self.min_frames else None
        self.reset()
        return done


class Trial:
    """One 30 s event-time window [t0, t0 + length) of blink / yawn measurements."""

    def __init__(self, label: str, length: float = TRIAL_SEC):
        self.label = label
        self.length = float(length)
        self.t0: Optional[float] = None          # event time the window opened
        self.started_at: Optional[datetime] = None
        self.blink_tracker = EpisodeTracker(BLINK_FRAME_THRESHOLD)
        self.yawn_tracker = EpisodeTracker(YAWN_FRAME_THRESHOLD)
        self.ears: List[float] = []              # per-frame EAR of valid in-window frames
        self.valid_s = 0.0                       # time covered by frames with a face
        self.closed_s = 0.0                      # part of it with eyes closed
        self.blinks: List[Event] = []            # blinks that BEGAN inside the window
        self.yawns: List[Event] = []
        self.max_gap_s = 0.0                     # longest stretch without a usable frame
        self.truncated = False
        self.done = False
        self._last_t: Optional[float] = None     # last valid frame inside the window

    @property
    def t1(self) -> Optional[float]:             # end of the window (exclusive)
        return None if self.t0 is None else self.t0 + self.length

    def remaining(self, now: float) -> Optional[float]:
        return None if self.t0 is None else max(0.0, self.t1 - now)

    # -- feeding frames -------------------------------------------------------
    def feed(self, f: Frame) -> None:
        if self.done:
            return
        if self.t0 is None:                      # window opens at the first face
            if not f.face:
                return
            self.t0, self.started_at = f.t, datetime.now()
        if f.t < self.t1:
            self._in_window(f)
        else:
            self._finish_open_episodes(f)

    def _add(self, events: List[Event], onset: float, duration_s: float):
        events.append(Event(onset_s=math.floor((onset - self.t0) * 1000) / 1000,
                            duration_ms=round(duration_s * 1000, 1)))

    def _in_window(self, f: Frame):
        if not f.face:                           # lost the face: drop open episodes
            self.blink_tracker.reset()
            self.yawn_tracker.reset()
            return
        if self._last_t is None:
            dt = 0.0
        else:
            gap = f.t - self._last_t
            dt = min(gap, MAX_FRAME_DT)
            if gap > MAX_FRAME_DT:
                self.max_gap_s = max(self.max_gap_s, gap)
        self._last_t = f.t
        self.valid_s += dt

        closed = f.ear < EAR_THRESHOLD
        if closed:
            self.closed_s += dt
        self.ears.append(float(f.ear))

        ended = self.blink_tracker.update(closed, f.t)
        if ended:
            self._add(self.blinks, *ended)
        ended = self.yawn_tracker.update(f.mar > YAWN_THRESHOLD, f.t)
        if ended:
            self._add(self.yawns, *ended)

    def _finish_open_episodes(self, f: Frame):
        """The window is over. Only episodes that began inside it may still finish."""
        pending = [(self.blink_tracker, self.blinks, f.face and f.ear < EAR_THRESHOLD),
                   (self.yawn_tracker, self.yawns, f.face and f.mar > YAWN_THRESHOLD)]
        for tracker, events, active in pending:
            if not tracker.ongoing:
                continue
            if not f.face:
                tracker.reset()                  # lost the face: drop it
            elif f.t - self.t1 > GRACE_MAX_S:
                if tracker.frames >= tracker.min_frames:   # still going: keep a lower bound
                    self._add(events, tracker.onset, f.t - tracker.onset)
                    self.truncated = True
                tracker.reset()
            else:
                ended = tracker.update(active, f.t)
                if ended:
                    self._add(events, *ended)
        if not (self.blink_tracker.ongoing or self.yawn_tracker.ongoing):
            self.done = True

    # -- results ----------------------------------------------------------------
    def metrics(self) -> dict:
        """Contract blink metrics. A metric that cannot be computed is omitted."""
        m = {}
        if self.ears:
            ears = np.array(self.ears)
            m["ear_median"] = round(float(np.median(ears)), 3)
            m["ear_p10"] = round(float(np.percentile(ears, 10)), 3)
        if self.valid_s >= MIN_VALID_S:
            m["blink_rate_per_min"] = round(len(self.blinks) / (self.valid_s / 60.0), 1)
            m["eyes_closed_pct"] = round(100.0 * self.closed_s / self.valid_s, 1)
            m["yawn_count"] = len(self.yawns)
            if self.blinks:
                d = np.array([b.duration_ms for b in self.blinks])
                m["median_duration_ms"] = round(float(np.median(d)), 1)
                m["p90_duration_ms"] = round(float(np.percentile(d, 90)), 1)
                m["long_closure_pct"] = round(100.0 * float(np.mean(d >= LONG_CLOSURE_MS)), 1)
        return m

    def quality(self) -> dict:
        """Contract quality block: quality_ok and data_sufficient are separate flags."""
        coverage = min(100.0, 100.0 * self.valid_s / self.length)
        gap = self.max_gap_s
        if self.done and self._last_t is not None:
            gap = max(gap, self.t1 - self._last_t)           # face lost at the end
        fps = (len(self.ears) - 1) / self.valid_s if self.valid_s > 0 and len(self.ears) > 1 else 0.0
        issues = []
        if coverage < MIN_COVERAGE_PCT:
            issues.append("low_coverage")
        if gap > MAX_FACE_GAP_S:
            issues.append("face_lost_gap")
        if 0 < fps < MIN_FPS:
            issues.append("low_frame_rate")
        if self.truncated:
            issues.append("episode_truncated")
        return {"quality_ok": not issues,
                "data_sufficient": coverage >= MIN_COVERAGE_PCT,
                "sample_count": len(self.ears),
                "valid_coverage_pct": round(coverage, 1),
                "issues": issues}


def windows_overlap(a: Trial, b: Trial) -> bool:
    """True if two trials' [t0, t0 + length) event-time windows share any instant."""
    return a.t0 < b.t0 + b.length and b.t0 < a.t0 + a.length


