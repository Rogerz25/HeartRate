def draw_trial_card(frame, label, color, remaining, progress, state, lines=()):
    """Trial label, countdown, progress bar and status (below the stats block)."""
    x, y = 10, 190
    cv2.putText(frame, label, (x, y + 10), cv2.FONT_HERSHEY_DUPLEX, 0.9, color, 2, cv2.LINE_AA)
    if remaining is None:
        clock = "--:--"
    else:
        secs = int(math.ceil(remaining))
        clock = f"{secs // 60:02d}:{secs % 60:02d}"
    cv2.putText(frame, clock, (x, y + 55), cv2.FONT_HERSHEY_DUPLEX, 1.4, (255, 255, 255), 2, cv2.LINE_AA)
    cv2.rectangle(frame, (x, y + 68), (x + 230, y + 78), (110, 110, 120), 1)
    fill = x + int(230 * min(max(progress, 0.0), 1.0))
    cv2.rectangle(frame, (x, y + 68), (fill, y + 78), color, -1)
    cv2.putText(frame, state, (x, y + 102), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 1, cv2.LINE_AA)
    for i, text in enumerate(lines):
        cv2.putText(frame, text, (x, y + 128 + 22 * i), cv2.FONT_HERSHEY_SIMPLEX, 0.5,
                    (200, 255, 200), 1, cv2.LINE_AA)


def draw_notice(frame, message):
